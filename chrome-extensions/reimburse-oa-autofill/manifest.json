{
  "manifest_version": 3,
  "name": "OA 报销自动填写",
  "version": "0.1.1",
  "description": "读取报销终稿 Excel，填入 OA 技术报销页。",
  "permissions": ["activeTab"],
  "host_permissions": ["https://oa.jugeng.com:8445/*"],
  "action": {
    "default_popup": "popup/index.html"
  },
  "content_scripts": [
    {
      "matches": ["https://oa.jugeng.com:8445/spa/workflow/static4form/index.html*"],
      "js": ["main-world.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://oa.jugeng.com:8445/spa/workflow/static4form/index.html*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
